CREATE TABLE Users (
    user_id INT IDENTITY(1,1) PRIMARY KEY,
    name NVARCHAR(50) NOT NULL,
    email NVARCHAR(100) NOT NULL,
    address NVARCHAR(100),
    phoneNumber NVARCHAR(15),
    user_name NVARCHAR(50),
    role NVARCHAR(20) DEFAULT 'User'
);

